# Web en Vercel sin configurar nada mas:
# EXPO_PUBLIC_SIGNALS_API_URL=/api/signals

# Mobile / Expo Go o frontend apuntando a un backend externo:
EXPO_PUBLIC_SIGNALS_API_URL=https://geopol-inteligencia-render.onrender.com/signals

# Alternativas:
# EXPO_PUBLIC_SIGNALS_API_BASE_URL=https://tu-servicio-render.onrender.com
# SIGNALS_SOURCE_URL=https://tu-backend-real.onrender.com/signals
